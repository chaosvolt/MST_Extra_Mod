msgstr "берестяной проход"

#. ~ Description for {'str': 'birchbark aisle'}
#: C:\Games\CataclysmBN\CBNE2\data\mods\MST_Extra_BN\vehicles\vehicleparts.json
msgid "An aisle made from a mat of tightly-woven birchbark."
msgstr "Проход, выложенный циновкой из плотно сплетённой бересты."

#: C:\Games\CataclysmBN\CBNE2\data\mods\MST_Extra_BN\vehicles\vehicleparts.json
#| msgid "birchbark sheath"
#| msgid_plural "birchbark sheathes"
