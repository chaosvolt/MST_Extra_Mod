#: .\items\armor.json
msgid "atlatl dart quiver"
msgid_plural "atlatl dart quivers"
msgstr[0] "колчан для дротиков"
msgstr[1] "колчана для дротиков"
msgstr[2] "колчанов для дротиков"

#. ~ Description for {'str': 'atlatl dart quiver'}
#: .\items\armor.json
msgid ""
"A leather quiver worn at the waist, lengthened to hold atlatl darts.  "
"Activate to store up to 10 darts."
msgstr "Удлиненный поясной кожаный колчан для хранения дротиков для атлатля. Активируйте, чтобы поместить до 10 дротиков."

#: .\items\armor.json
msgid "birchbark atlatl dart quiver"
