#. ~ Description for {'str': 'clay ember carrier'}
#: C:\Games\CataclysmBN\CBNE2\data\mods\MST_Extra_BN\items\tools.json
msgid "This is a small ceramic fire pot, with a lid and small holes for controlled airflow.  It can nurture a smoldering ember for a long time, to start fires without modern tools."
msgstr "Небольшой керамический сосуд с крышкой и отверстиями для регулируемого притока воздуха. В нём можно подолгу сохранять тлеющие угли, чтобы затем разводить огонь без современных приспособлений."

#: C:\Games\CataclysmBN\CBNE2\data\mods\MST_Extra_BN\items\tools.json
msgid "clay ember carrier (lit)"
msgid_plural "clay ember carriers (lit)"
msgstr[0] "глиняный сосуд с тлеющими углями"
msgstr[1] "глиняных сосуда с тлеющими углями"
msgstr[2] "глиняных сосудов с тлеющими углями"

