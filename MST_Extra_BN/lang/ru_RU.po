msgstr[2] "атлатлей"

#: .\items\ranged.json
msgid ""
"A wooden tool for supporting a javelin, to throw it more effectively than by "
"hand."
msgstr "Деревянное приспособление для метания дротиков с большей эффективностью, нежели руками."

