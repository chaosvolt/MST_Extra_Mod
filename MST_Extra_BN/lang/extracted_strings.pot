#: ./items/comestibles.json
msgid "willow tea"
msgid_plural "willow tea"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'willow tea'}
#: ./items/comestibles.json
msgid ""
"A bitter herbal tea made from willow bark, used since ancient times as a "
"mild painkiller."
msgstr ""

#: ./items/comestibles.json
msgid "garlic oil"
msgid_plural "garlic oil"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'garlic oil'}
#: ./items/comestibles.json
msgid ""
"A strong-tasting extract made from garlic, traditionally used to help resist"
" infection, especially in Eastern Europe.  Not as powerful as modern full-"
"strength antibiotics, but better than nothing.  Use once every 12 hours."
msgstr ""

#: ./items/comestibles.json
msgid "makeshift poultice"
msgid_plural "makeshift poultices"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str': 'makeshift poultice'}
#: ./items/comestibles.json
msgid ""
"A primitive poultice using improvised antiseptic, held in place by a cloth "
"or leather wrap.  Applied loosely, it is designed to stave off infection but"
" can still help staunch bleeding."
msgstr ""

#: ./items/comestibles.json
msgid "posca"
msgid_plural "posca"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'posca'}
#: ./items/comestibles.json
msgid ""
"A traditional Roman drink made of water mixed with a bit of vinegar, then "
"spiced up with herbs and honey.  A good way to quench one's thirst on a long"
" march."
msgstr ""

#: ./items/comestibles.json
msgid "hard posca"
msgid_plural "hard posca"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'hard posca'}
#: ./items/comestibles.json
msgid ""
"A traditional Roman drink made of water mixed with a bit of sour wine, then "
"spiced up with herbs and honey.  Good for unwinding after a long march."
msgstr ""

#: ./items/comestibles.json
msgid "cooked cattail rhizome"
msgid_plural "cooked cattail rhizomes"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str': 'cooked cattail rhizome'}
#: ./items/comestibles.json
msgid ""
"A cooked rhizome from a cattail plant.  Crisp and starchy, it's a fair bit "
"less stringy and more palatable after being cooked."
msgstr ""

